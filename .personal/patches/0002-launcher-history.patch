diff --git a/Tinycast/Features/LauncherHistory/Model/LauncherHistory.swift b/Tinycast/Features/LauncherHistory/Model/LauncherHistory.swift
new file mode 100644
index 0000000000000000000000000000000000000000..b82942e7374d80aca0d10f79eedb18130dd3f24a
--- /dev/null
+++ b/Tinycast/Features/LauncherHistory/Model/LauncherHistory.swift
@@ -0,0 +1,49 @@
+import Foundation
+
+/// One validated launcher query, exactly as it was typed.
+struct LauncherHistoryEntry: Codable, Hashable, Sendable, Identifiable {
+    let id: UUID
+    let text: String
+    var lastValidatedAt: Date
+}
+
+/// The launcher's validated queries, newest first, each text at most once.
+struct LauncherHistory: Codable, Equatable, Sendable {
+    static let capacity = 100
+
+    private(set) var entries: [LauncherHistoryEntry]
+
+    init(entries: [LauncherHistoryEntry] = []) {
+        self.entries = Array(entries.prefix(Self.capacity))
+    }
+
+    var texts: [String] { entries.map(\.text) }
+
+    /// A text validated before moves to the front with its id; false when there is nothing to keep.
+    @discardableResult
+    mutating func record(_ text: String, at date: Date, makeID: () -> UUID = UUID.init) -> Bool {
+        guard Self.isRecordable(text) else { return false }
+        if let index = entries.firstIndex(where: { $0.text == text }) {
+            var entry = entries.remove(at: index)
+            entry.lastValidatedAt = date
+            entries.insert(entry, at: 0)
+        } else {
+            entries.insert(LauncherHistoryEntry(id: makeID(), text: text, lastValidatedAt: date), at: 0)
+            if entries.count > Self.capacity { entries.removeLast(entries.count - Self.capacity) }
+        }
+        return true
+    }
+
+    /// Only emptiness is judged on a trimmed copy; the stored text keeps every space it had.
+    static func isRecordable(_ text: String) -> Bool {
+        !text.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty
+    }
+
+    func encoded() throws -> Data {
+        try JSONEncoder().encode(self)
+    }
+
+    static func decoded(from data: Data) throws -> LauncherHistory {
+        try JSONDecoder().decode(LauncherHistory.self, from: data)
+    }
+}
diff --git a/Tinycast/Features/LauncherHistory/Model/LauncherHistorySession.swift b/Tinycast/Features/LauncherHistory/Model/LauncherHistorySession.swift
new file mode 100644
index 0000000000000000000000000000000000000000..9ccc2698bddc1e9bbc19ace159fb1c6a39b6ab85
--- /dev/null
+++ b/Tinycast/Features/LauncherHistory/Model/LauncherHistorySession.swift
@@ -0,0 +1,184 @@
+import Foundation
+
+/// The history's rules as a value: each event returns the texts to record, and touches nothing.
+struct LauncherHistorySession: Equatable {
+    /// Who put the current query in the field.
+    enum Origin: Equatable {
+        case typed
+        /// ↑ wrote it from the history; showing its results again records nothing.
+        case recalled
+        /// An action rewrote it, as ⌘↵ does with an answer; it was never typed.
+        case rewritten
+    }
+
+    /// A walk through a snapshot taken on the first ↑, so a write meanwhile cannot shift it.
+    struct Recall: Equatable {
+        let texts: [String]
+        var index: Int
+
+        var current: String { texts[index] }
+    }
+
+    enum UpArrow: Equatable {
+        /// Not a history key here: the launcher navigates its rows as it always has.
+        case ignore
+        /// Put this text in the field.
+        case write(String)
+        /// Already at the oldest entry: the key is consumed and nothing loops.
+        case stay
+    }
+
+    /// Long enough that a result flashing past mid-typing is not taken for one the user read.
+    static let presentationDwell: TimeInterval = 0.7
+
+    private(set) var query = ""
+    private(set) var origin = Origin.typed
+    private(set) var recall: Recall?
+    /// A result shown for typed text, recorded once read or once the palette leaves with it.
+    private(set) var shown: Shown?
+    /// The query whose result was already recorded, so showing it again is not a second event.
+    private(set) var settled: String?
+    /// The rewrite token last drawn; a new one means an action, not a keystroke, wrote the field.
+    private var seenRewriteToken: UUID?
+
+    struct Shown: Equatable {
+        let text: String
+        let since: Date
+    }
+
+    /// Recall starts only from a strictly empty field, and continues only while ↑ wrote the text.
+    mutating func upArrow(query current: String, history: [String]) -> UpArrow {
+        if current.isEmpty {
+            guard !history.isEmpty else { return .ignore }
+            recall = Recall(texts: history, index: 0)
+            return .write(history[0])
+        }
+        guard var recall, origin == .recalled, current == recall.current else { return .ignore }
+        guard recall.index + 1 < recall.texts.count else { return .stay }
+        recall.index += 1
+        self.recall = recall
+        return .write(recall.current)
+    }
+
+    /// The field as drawn, with `PaletteState.queryRewriteToken`, which an action's rewrite bumps.
+    mutating func observe(
+        query text: String, rewriteToken: UUID, resultShown: Bool, at now: Date
+    ) -> [String] {
+        // The compact bar mounts the list only once ↑ has filled the field, so no token was seen.
+        let rewritten = seenRewriteToken.map { $0 != rewriteToken } ?? (recall?.current == text)
+        seenRewriteToken = rewriteToken
+        return observe(query: text, rewritten: rewritten, resultShown: resultShown, at: now)
+    }
+
+    /// The field changed. `rewritten` says an action wrote it rather than a keystroke.
+    mutating func observe(
+        query text: String, rewritten: Bool, resultShown: Bool, at now: Date
+    ) -> [String] {
+        var recorded: [String] = []
+        if text != query {
+            recorded += settleShown(at: now, requiringDwell: true)
+            if rewritten, let recall, text == recall.current {
+                origin = .recalled
+            } else {
+                recall = nil
+                origin = rewritten ? .rewritten : .typed
+            }
+            query = text
+            settled = nil
+        }
+        if resultShown, origin == .typed, settled != text, LauncherHistory.isRecordable(text) {
+            if shown?.text != text { shown = Shown(text: text, since: now) }
+        } else if shown != nil {
+            recorded += settleShown(at: now, requiringDwell: true)
+        }
+        return recorded
+    }
+
+    /// The launcher left: a hidden palette had its result read, a swapped screen may not have.
+    mutating func left(at now: Date, paletteHidden: Bool) -> [String] {
+        recall = nil
+        seenRewriteToken = nil
+        return settleShown(at: now, requiringDwell: !paletteHidden)
+    }
+
+    /// An action was taken on the current query: the text it validates, or nil when there is none.
+    mutating func validate() -> String? {
+        guard origin != .rewritten, LauncherHistory.isRecordable(query) else { return nil }
+        // The result on screen and the action on it are one event, recorded once.
+        if shown?.text == query { shown = nil }
+        settled = query
+        return query
+    }
+
+    /// Locking the session forgets the walk and anything not yet recorded.
+    mutating func reset() {
+        self = LauncherHistorySession()
+    }
+
+    private mutating func settleShown(at now: Date, requiringDwell: Bool) -> [String] {
+        guard let shown else { return [] }
+        self.shown = nil
+        guard !requiringDwell || now.timeIntervalSince(shown.since) >= Self.presentationDwell else {
+            return []
+        }
+        settled = shown.text
+        return [shown.text]
+    }
+}
+
+/// The last validation, held a moment so a refused confirmation or a missing argument can undo it.
+struct LauncherHistoryUndo: Equatable {
+    /// An action's own dialog opens within moments; one later belongs to something else.
+    static let confirmationWindow: TimeInterval = 2
+
+    private(set) var pending: Pending?
+
+    struct Pending: Equatable {
+        let before: LauncherHistory
+        var after: LauncherHistory
+        var at: Date
+        var awaitingConfirmation = false
+    }
+
+    /// Validations of one gesture (a menu row, then the launch it runs) undo together.
+    mutating func recorded(before: LauncherHistory, after: LauncherHistory, at now: Date) {
+        if var pending, pending.after == before,
+            now.timeIntervalSince(pending.at) <= Self.confirmationWindow
+        {
+            pending.after = after
+            pending.at = now
+            self.pending = pending
+        } else {
+            pending = Pending(before: before, after: after, at: now)
+        }
+    }
+
+    mutating func confirmationBegan(at now: Date) {
+        guard var pending, !pending.awaitingConfirmation,
+            now.timeIntervalSince(pending.at) <= Self.confirmationWindow
+        else {
+            if pending?.awaitingConfirmation == false { pending = nil }
+            return
+        }
+        pending.awaitingConfirmation = true
+        self.pending = pending
+    }
+
+    /// The history to restore when the awaited confirmation was refused, if nothing moved since.
+    mutating func confirmationEnded(accepted: Bool, current: LauncherHistory) -> LauncherHistory? {
+        guard let pending, pending.awaitingConfirmation else { return nil }
+        self.pending = nil
+        return !accepted && current == pending.after ? pending.before : nil
+    }
+
+    /// The launch asked for its arguments instead of running.
+    mutating func withdraw(current: LauncherHistory, at now: Date) -> LauncherHistory? {
+        guard let pending, now.timeIntervalSince(pending.at) <= Self.confirmationWindow else { return nil }
+        self.pending = nil
+        return current == pending.after ? pending.before : nil
+    }
+
+    mutating func clear() {
+        pending = nil
+    }
+}
diff --git a/Tinycast/Features/LauncherHistory/Service/LauncherHistoryStore.swift b/Tinycast/Features/LauncherHistory/Service/LauncherHistoryStore.swift
new file mode 100644
index 0000000000000000000000000000000000000000..429df4dec456e713947f1057e3fac9bb6aec70ec
--- /dev/null
+++ b/Tinycast/Features/LauncherHistory/Service/LauncherHistoryStore.swift
@@ -0,0 +1,67 @@
+import Foundation
+
+/// The sealed `command-input-history.enc`, loaded on first use and dropped again on lock.
+@MainActor
+final class LauncherHistoryStore {
+    enum State: Equatable {
+        case unloaded
+        case loaded(LauncherHistory)
+        case unavailable(SealedFile.Failure)
+    }
+
+    private let file: SealedFile
+    private(set) var state = State.unloaded
+
+    init(file: SealedFile = .launcherHistory) {
+        self.file = file
+    }
+
+    var isUnavailable: Bool {
+        if case .unavailable = state { return true }
+        return false
+    }
+
+    /// Nil while the file or its key cannot be read; nothing is written over it until it can.
+    func history() -> LauncherHistory? {
+        if case .unloaded = state { load() }
+        guard case .loaded(let history) = state else { return nil }
+        return history
+    }
+
+    @discardableResult
+    func save(_ history: LauncherHistory) -> Bool {
+        guard case .loaded = state else { return false }
+        do {
+            try file.write(history.encoded())
+        } catch let failure as SealedFile.Failure {
+            state = .unavailable(failure)
+            return false
+        } catch {
+            state = .unavailable(.corrupted(.unknownFormat))
+            return false
+        }
+        state = .loaded(history)
+        return true
+    }
+
+    /// Forgets the decrypted entries; the next use reads the file again.
+    func release() {
+        state = .unloaded
+    }
+
+    func erase() throws {
+        try file.erase()
+        state = .loaded(LauncherHistory())
+    }
+
+    private func load() {
+        do {
+            let data = try file.read()
+            state = .loaded(try data.map(LauncherHistory.decoded) ?? LauncherHistory())
+        } catch let failure as SealedFile.Failure {
+            state = .unavailable(failure)
+        } catch {
+            state = .unavailable(.corrupted(.unknownFormat))
+        }
+    }
+}
diff --git a/Tinycast/Features/LauncherHistory/UI/LauncherHistoryCoordinator.swift b/Tinycast/Features/LauncherHistory/UI/LauncherHistoryCoordinator.swift
new file mode 100644
index 0000000000000000000000000000000000000000..850d39482ebe3e2d20fe933837b60ce1e8999e83
--- /dev/null
+++ b/Tinycast/Features/LauncherHistory/UI/LauncherHistoryCoordinator.swift
@@ -0,0 +1,202 @@
+import SwiftUI
+
+/// Owns the launcher's input history: ↑ recall, what counts as validated, and its sealed file.
+@MainActor
+final class LauncherHistoryCoordinator {
+    private let palette: PaletteState
+    private let store: LauncherHistoryStore
+    private let now: () -> Date
+    /// Dialogs and HUDs only, through the forwarders every feature uses.
+    private unowned let core: AppCore
+    private var session = LauncherHistorySession()
+    private var undo = LauncherHistoryUndo()
+    private var isLocked = false
+    /// Set between a palette launch and its return, the span its own argument request lands in.
+    private var isLaunchingFromPalette = false
+    private var observers: [NotificationToken] = []
+    /// One HUD per file and session, so a broken key does not report on every keystroke.
+    private var reportedFiles: Set<String> = []
+
+    init(
+        palette: PaletteState, core: AppCore, store: LauncherHistoryStore = LauncherHistoryStore(),
+        now: @escaping () -> Date = Date.init
+    ) {
+        self.palette = palette
+        self.core = core
+        self.store = store
+        self.now = now
+    }
+
+    func start() {
+        let distributed = DistributedNotificationCenter.default()
+        observers = [
+            observe(distributed, Notification.Name("com.apple.screenIsLocked")) { $0.lock() },
+            observe(distributed, Notification.Name("com.apple.screenIsUnlocked")) { $0.unlock() },
+            observe(NotificationCenter.default, SealedFile.didFailNotification) { coordinator in
+                coordinator.reportUnavailable()
+            }
+        ]
+        // The calculator and ranking stores read their files before anything could listen.
+        reportUnavailable()
+    }
+
+    // MARK: - Recall
+
+    /// ↑ in the launcher's own field; true when the key recalled, or sat at the oldest entry.
+    func recall(modifiers: EventModifiers, menuOpen: Bool, fieldFocused: Bool) -> Bool {
+        guard palette.mode == .launcher, fieldFocused, !menuOpen, !isLocked,
+            modifiers.isDisjoint(with: [.command, .option, .control, .shift]),
+            !palette.isComposing, !palette.isControlListOpen
+        else { return false }
+        let query = palette.query
+        guard query.isEmpty || session.recall != nil else { return false }
+        guard let history = store.history() else {
+            if query.isEmpty { reportUnavailable() }
+            return false
+        }
+        switch session.upArrow(query: query, history: history.texts) {
+        case .ignore: return false
+        case .stay: return true
+        case .write(let text):
+            palette.rewriteQuery(text)
+            return true
+        }
+    }
+
+    // MARK: - What the launcher shows
+
+    /// The field and its lead card as last drawn, from `LauncherHistoryObserver`.
+    func observe(query: String, rewriteToken: UUID, resultShown: Bool) {
+        record(
+            session.observe(query: query, rewriteToken: rewriteToken, resultShown: resultShown, at: now()))
+    }
+
+    /// A hidden palette also drops the decrypted entries; the next ↑ or record reads them again.
+    func launcherLeft(paletteHidden: Bool) {
+        record(session.left(at: now(), paletteHidden: paletteHidden))
+        if paletteHidden { store.release() }
+    }
+
+    // MARK: - Validation
+
+    /// An action ran on the launcher's query: a row, a menu item, a copy, an answer chained on.
+    func noteAction() {
+        guard palette.mode == .launcher, palette.isVisible, !isLocked,
+            let text = session.validate()
+        else { return }
+        record([text], undoable: true)
+    }
+
+    /// The launch funnel: only the palette passes a query, so a hotkey's launch records nothing.
+    func noteLaunch(searchQuery: String?) {
+        isLaunchingFromPalette = searchQuery != nil
+        if isLaunchingFromPalette { noteAction() }
+    }
+
+    /// After a launch dispatched: one that asked for its arguments instead did not run.
+    func launchDispatched() {
+        defer { isLaunchingFromPalette = false }
+        guard isLaunchingFromPalette, !isLocked, palette.pendingArgumentEntryID != nil,
+            let history = store.history(),
+            let restored = undo.withdraw(current: history, at: now())
+        else { return }
+        store.save(restored)
+    }
+
+    func confirmationWillBegin() {
+        undo.confirmationBegan(at: now())
+    }
+
+    func confirmationDidEnd(confirmed: Bool) {
+        guard !isLocked, let history = store.history(),
+            let restored = undo.confirmationEnded(accepted: confirmed, current: history)
+        else { return }
+        store.save(restored)
+    }
+
+    /// A result still on screen at quit was read; it is recorded as a hide would record it.
+    func prepareForTermination() {
+        if palette.isVisible, palette.mode == .launcher { launcherLeft(paletteHidden: true) }
+    }
+
+    // MARK: - Clear Launcher History
+
+    func clearHistory() async {
+        guard
+            await core.confirm(
+                title: String(localized: "Clear launcher history?", table: "PersonalEdition"),
+                message: String(
+                    localized: "Every recalled search goes, and its key with it. This can't be undone.",
+                    table: "PersonalEdition"),
+                symbol: CommandID.clearLauncherHistory.sfSymbol,
+                confirmTitle: String(localized: "Clear History", table: "PersonalEdition"))
+        else { return }
+        do {
+            try store.erase()
+        } catch {
+            await core.showNotice(
+                title: String(localized: "Couldn’t clear launcher history", table: "PersonalEdition"),
+                message: error.localizedDescription, symbol: "exclamationmark.triangle",
+                tone: .danger)
+            return
+        }
+        session.reset()
+        undo.clear()
+        reportedFiles.remove(SealedFile.launcherHistory.url.lastPathComponent)
+        core.showMessage(String(localized: "Launcher history cleared", table: "PersonalEdition"))
+    }
+
+    // MARK: - Private
+
+    private func record(_ texts: [String], undoable: Bool = false) {
+        guard !isLocked else { return }
+        guard !texts.isEmpty, let before = store.history() else {
+            if !texts.isEmpty { reportUnavailable() }
+            return
+        }
+        var after = before
+        let timestamp = now()
+        for text in texts { after.record(text, at: timestamp) }
+        guard after != before, store.save(after) else { return }
+        if undoable { undo.recorded(before: before, after: after, at: timestamp) }
+    }
+
+    /// Locking forgets the walk, the decrypted entries and any undo; unlocking reads them anew.
+    private func lock() {
+        isLocked = true
+        session.reset()
+        undo.clear()
+        store.release()
+    }
+
+    private func unlock() {
+        isLocked = false
+    }
+
+    private func reportUnavailable() {
+        let files: [SealedFile] = [.launcherHistory, .calculatorHistory, .launcherRanking]
+        let failed = files
+            .filter { $0.blocked || $0 === SealedFile.launcherHistory && store.isUnavailable }
+            .map(\.url.lastPathComponent)
+            .filter { !reportedFiles.contains($0) }
+        guard !failed.isEmpty else { return }
+        reportedFiles.formUnion(failed)
+        let names = failed.joined(separator: ", ")
+        core.showMessage(
+            String(localized: "Encrypted history unavailable: \(names)", table: "PersonalEdition"),
+            tone: .danger)
+    }
+
+    private func observe(
+        _ center: NotificationCenter, _ name: Notification.Name,
+        _ handler: @escaping @Sendable @MainActor (LauncherHistoryCoordinator) -> Void
+    ) -> NotificationToken {
+        NotificationToken(
+            center.addObserver(forName: name, object: nil, queue: .main) { [weak self] _ in
+                MainActor.assumeIsolated {
+                    guard let self else { return }
+                    handler(self)
+                }
+            }, center: center)
+    }
+}
diff --git a/Tinycast/Features/LauncherHistory/UI/LauncherHistoryObserver.swift b/Tinycast/Features/LauncherHistory/UI/LauncherHistoryObserver.swift
new file mode 100644
index 0000000000000000000000000000000000000000..16f8e881c2de0b8d2ce1f27572c368f259f05b7f
--- /dev/null
+++ b/Tinycast/Features/LauncherHistory/UI/LauncherHistoryObserver.swift
@@ -0,0 +1,40 @@
+import SwiftUI
+
+extension View {
+    /// Reports the launcher's field and lead card as drawn, which is what "shown" means here.
+    func launcherHistory(
+        _ coordinator: LauncherHistoryCoordinator, palette: PaletteState, resultShown: Bool
+    ) -> some View {
+        modifier(
+            LauncherHistoryObserver(coordinator: coordinator, palette: palette, resultShown: resultShown))
+    }
+}
+
+/// One change handler for the field, its rewrite token and the card, so they arrive in one event.
+private struct LauncherHistoryObserver: ViewModifier {
+    let coordinator: LauncherHistoryCoordinator
+    let palette: PaletteState
+    let resultShown: Bool
+
+    private struct Drawn: Equatable {
+        let query: String
+        let rewriteToken: UUID
+        let resultShown: Bool
+    }
+
+    func body(content: Content) -> some View {
+        content
+            .onChange(of: drawn, initial: true) { _, drawn in
+                coordinator.observe(
+                    query: drawn.query, rewriteToken: drawn.rewriteToken, resultShown: drawn.resultShown)
+            }
+            .onChange(of: palette.isVisible) { _, visible in
+                if !visible { coordinator.launcherLeft(paletteHidden: true) }
+            }
+            .onDisappear { coordinator.launcherLeft(paletteHidden: !palette.isVisible) }
+    }
+
+    private var drawn: Drawn {
+        Drawn(query: palette.query, rewriteToken: palette.queryRewriteToken, resultShown: resultShown)
+    }
+}
