diff --git a/Tinycast/Platform/SealedEnvelope.swift b/Tinycast/Platform/SealedEnvelope.swift
new file mode 100644
index 0000000000000000000000000000000000000000..964f2653230a417f73ca9d7f9e151a09a5448025
--- /dev/null
+++ b/Tinycast/Platform/SealedEnvelope.swift
@@ -0,0 +1,44 @@
+import CryptoKit
+import Foundation
+
+/// AES-256-GCM behind a versioned header; header and purpose are authenticated, never trusted.
+enum SealedEnvelope {
+    enum Failure: Error, Equatable {
+        case truncated
+        case unknownFormat
+        case unsupportedVersion
+        case authentication
+    }
+
+    static let magic = Data("TCSE".utf8)
+    static let version: UInt8 = 1
+    /// A random 96-bit nonce and a 128-bit tag, as `AES.GCM.SealedBox.combined` lays them out.
+    private static let boxOverhead = 12 + 16
+
+    private static var header: Data { magic + [version] }
+
+    static func seal(_ plaintext: Data, key: SymmetricKey, purpose: String) throws -> Data {
+        let box = try AES.GCM.seal(
+            plaintext, using: key, nonce: AES.GCM.Nonce(),
+            authenticating: associatedData(purpose: purpose))
+        guard let combined = box.combined else { throw Failure.unknownFormat }
+        return header + combined
+    }
+
+    static func open(_ envelope: Data, key: SymmetricKey, purpose: String) throws(Failure) -> Data {
+        let header = header
+        guard envelope.count >= header.count + boxOverhead else { throw .truncated }
+        guard envelope.prefix(magic.count) == magic else { throw .unknownFormat }
+        guard envelope[envelope.startIndex + magic.count] == version else { throw .unsupportedVersion }
+        do {
+            let box = try AES.GCM.SealedBox(combined: envelope.dropFirst(header.count))
+            return try AES.GCM.open(box, using: key, authenticating: associatedData(purpose: purpose))
+        } catch {
+            throw .authentication
+        }
+    }
+
+    private static func associatedData(purpose: String) -> Data {
+        header + Data("tinycast-sealed-file:\(purpose)".utf8)
+    }
+}
diff --git a/Tinycast/Platform/SealedFile.swift b/Tinycast/Platform/SealedFile.swift
new file mode 100644
index 0000000000000000000000000000000000000000..ab76702049f1d25f8fccd5279b220699e5a5e34d
--- /dev/null
+++ b/Tinycast/Platform/SealedFile.swift
@@ -0,0 +1,274 @@
+import CryptoKit
+import Darwin
+import Foundation
+import Synchronization
+
+/// A file that only reaches disk sealed under its own key, kept in one shared Keychain item.
+final class SealedFile: Sendable {
+    enum Failure: Error, Equatable {
+        /// The file exists but its key is gone; a new key would make it unreadable for good.
+        case keyMissing
+        case keychain(OSStatus)
+        case corrupted(SealedEnvelope.Failure)
+        case tooLarge
+        case io(Int32)
+        case migrationMismatch
+        /// A read failed earlier this session, so writing could overwrite what it holds.
+        case blocked
+    }
+
+    /// Each file's key name; erasing one key leaves the others readable.
+    enum Account {
+        /// One item for every key: macOS asks a new self-signed build once per item, not per file.
+        static let keyring = UUID(uuidString: "46539D21-2A6F-43A4-9C6E-2501A797EDCF")!
+        static let launcherHistory = UUID(uuidString: "6B2F4E1A-0C7D-4B53-9E58-2D4A61C3F0A1")!
+        static let calculatorHistory = UUID(uuidString: "C1E5A7D2-3F84-4E09-A6B1-7D0F2C95E4B3")!
+        static let launcherRanking = UUID(uuidString: "4A9D0B63-E2C1-47F8-8B5E-91C3D6A70F2E")!
+    }
+
+    static let launcherHistory = SealedFile(
+        name: "command-input-history.enc", account: Account.launcherHistory)
+    static let calculatorHistory = SealedFile(
+        name: "calculator-history.enc", legacyName: "calculator-history.json",
+        account: Account.calculatorHistory)
+    static let launcherRanking = SealedFile(
+        name: "launcher-ranking.enc", legacyName: "launcher-ranking.json",
+        account: Account.launcherRanking)
+
+    /// Posted with the file name when a read or write fails; the coordinator turns it into a HUD.
+    static let didFailNotification = Notification.Name("SealedFileDidFail")
+    static let sizeLimit = 16 * 1024 * 1024
+
+    let url: URL
+    private let legacyURL: URL?
+    private let keyringLockURL: URL
+    private let purpose: String
+    private let account: UUID
+    private let keychain: KeychainSecretStore
+    private let isBlocked = Mutex(false)
+    /// Every file rewrites the same keyring item, so its read-modify-write is serialized.
+    private static let keyringLock = Mutex(())
+
+    init(
+        name: String, legacyName: String? = nil, account: UUID,
+        directory: URL = AppPaths.applicationSupport(),
+        keychain: KeychainSecretStore = .sealedStorageKeys
+    ) {
+        url = directory.appendingPathComponent(name, isDirectory: false)
+        legacyURL = legacyName.map { directory.appendingPathComponent($0, isDirectory: false) }
+        keyringLockURL = directory.appendingPathComponent(".sealed-keyring.lock", isDirectory: false)
+        purpose = name
+        self.account = account
+        self.keychain = keychain
+    }
+
+    var blocked: Bool { isBlocked.withLock { $0 } }
+
+    /// The plaintext, or nil when nothing was ever stored. A legacy plain file is sealed first.
+    func read() throws(Failure) -> Data? {
+        do {
+            let plaintext = try readOrMigrate()
+            isBlocked.withLock { $0 = false }
+            return plaintext
+        } catch {
+            isBlocked.withLock { $0 = true }
+            report()
+            throw error
+        }
+    }
+
+    func write(_ plaintext: Data) throws(Failure) {
+        guard !blocked else { throw .blocked }
+        do {
+            try seal(plaintext)
+        } catch {
+            report()
+            throw error
+        }
+    }
+
+    /// Deletes the file and its key, so a copy of it left anywhere can no longer be opened.
+    func erase() throws(Failure) {
+        for target in [url, legacyURL].compactMap(\.self) {
+            guard unlink(target.path) == 0 || errno == ENOENT else { throw .io(errno) }
+        }
+        try withKeyringLock { () throws(Failure) in
+            var entries = try keyring()
+            entries[account.uuidString] = nil
+            try saveKeyring(entries)
+            try keychainCall { try keychain.removeSecret(for: account) }
+        }
+        isBlocked.withLock { $0 = false }
+    }
+
+    private func readOrMigrate() throws(Failure) -> Data? {
+        let sealed = try contents(of: url)
+        guard let legacyURL, let legacy = try contents(of: legacyURL) else {
+            guard let sealed else { return nil }
+            return try open(sealed)
+        }
+        // Both exist after a crash mid-migration or a return to the official build: newer wins.
+        if let sealed, modificationDate(url) >= modificationDate(legacyURL) {
+            let plaintext = try open(sealed)
+            try remove(legacyURL)
+            return plaintext
+        }
+        try seal(legacy)
+        guard let resealed = try contents(of: url), try open(resealed) == legacy else {
+            throw .migrationMismatch
+        }
+        try remove(legacyURL)
+        return legacy
+    }
+
+    private func open(_ envelope: Data) throws(Failure) -> Data {
+        guard let key = try existingKey() else { throw .keyMissing }
+        do {
+            return try SealedEnvelope.open(envelope, key: key, purpose: purpose)
+        } catch {
+            throw .corrupted(error)
+        }
+    }
+
+    private func seal(_ plaintext: Data) throws(Failure) {
+        let key: SymmetricKey
+        if let existing = try existingKey() {
+            key = existing
+        } else if FileManager.default.fileExists(atPath: url.path) {
+            throw .keyMissing
+        } else {
+            key = try createKey()
+        }
+        let envelope: Data
+        do {
+            envelope = try SealedEnvelope.seal(plaintext, key: key, purpose: purpose)
+        } catch {
+            throw .corrupted(.unknownFormat)
+        }
+        try replaceAtomically(with: envelope)
+    }
+
+    /// A private temporary beside the file, renamed over it: only sealed bytes are written.
+    private func replaceAtomically(with envelope: Data) throws(Failure) {
+        let temporary = url.deletingLastPathComponent()
+            .appendingPathComponent(".\(url.lastPathComponent).\(UUID().uuidString).tmp")
+        let descriptor = Darwin.open(temporary.path, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0o600)
+        guard descriptor >= 0 else { throw .io(errno) }
+        let handle = FileHandle(fileDescriptor: descriptor, closeOnDealloc: true)
+        do {
+            try handle.write(contentsOf: envelope)
+            try handle.synchronize()
+            try handle.close()
+        } catch {
+            unlink(temporary.path)
+            throw .io(EIO)
+        }
+        guard rename(temporary.path, url.path) == 0 else {
+            let code = errno
+            unlink(temporary.path)
+            throw .io(code)
+        }
+    }
+
+    private func contents(of file: URL) throws(Failure) -> Data? {
+        var status = stat()
+        guard stat(file.path, &status) == 0 else {
+            if errno == ENOENT { return nil }
+            throw .io(errno)
+        }
+        guard status.st_size <= off_t(Self.sizeLimit) else { throw .tooLarge }
+        do {
+            return try Data(contentsOf: file)
+        } catch {
+            throw .io(EIO)
+        }
+    }
+
+    private func remove(_ file: URL) throws(Failure) {
+        guard unlink(file.path) == 0 || errno == ENOENT else { throw .io(errno) }
+    }
+
+    private func modificationDate(_ file: URL) -> Date {
+        let attributes = try? FileManager.default.attributesOfItem(atPath: file.path)
+        return attributes?[.modificationDate] as? Date ?? .distantPast
+    }
+
+    /// A key still in its own pre-keyring item moves into the keyring on first use.
+    private func existingKey() throws(Failure) -> SymmetricKey? {
+        try withKeyringLock { () throws(Failure) -> SymmetricKey? in
+            var entries = try keyring()
+            if let stored = entries[account.uuidString] { return try decodedKey(stored) }
+            guard let legacy = try keychainCall({ try keychain.secret(for: account) }) else { return nil }
+            let key = try decodedKey(legacy)
+            entries[account.uuidString] = legacy
+            try saveKeyring(entries)
+            try? keychain.removeSecret(for: account)
+            return key
+        }
+    }
+
+    private func createKey() throws(Failure) -> SymmetricKey {
+        let key = SymmetricKey(size: .bits256)
+        let encoded = key.withUnsafeBytes { Data($0).base64EncodedString() }
+        try withKeyringLock { () throws(Failure) in
+            var entries = try keyring()
+            entries[account.uuidString] = encoded
+            try saveKeyring(entries)
+        }
+        return key
+    }
+
+    /// Settings runs in a second process, so a keyring update also holds a file lock.
+    private func withKeyringLock<Value>(_ body: () throws(Failure) -> Value) throws(Failure) -> Value {
+        try Self.keyringLock.withLock { _ throws(Failure) -> Value in
+            let descriptor = Darwin.open(keyringLockURL.path, O_RDWR | O_CREAT | O_CLOEXEC, 0o600)
+            guard descriptor >= 0 else { throw .io(errno) }
+            defer { close(descriptor) }
+            guard flock(descriptor, LOCK_EX) == 0 else { throw .io(errno) }
+            return try body()
+        }
+    }
+
+    private func decodedKey(_ encoded: String) throws(Failure) -> SymmetricKey {
+        guard let bytes = Data(base64Encoded: encoded), bytes.count == 32 else {
+            throw .keychain(errSecDecode)
+        }
+        return SymmetricKey(data: bytes)
+    }
+
+    /// An unreadable keyring throws: rewriting it would lose the keys of the other files.
+    private func keyring() throws(Failure) -> [String: String] {
+        guard let stored = try keychainCall({ try keychain.secret(for: Account.keyring) }) else {
+            return [:]
+        }
+        guard let entries = try? JSONDecoder().decode([String: String].self, from: Data(stored.utf8))
+        else { throw .keychain(errSecDecode) }
+        return entries
+    }
+
+    private func saveKeyring(_ entries: [String: String]) throws(Failure) {
+        try keychainCall { try keychain.setValues(entries, for: Account.keyring) }
+    }
+
+    private func keychainCall<Value>(_ body: () throws -> Value) throws(Failure) -> Value {
+        do {
+            return try body()
+        } catch let KeychainSecretStore.StoreError.keychain(status) {
+            throw .keychain(status)
+        } catch {
+            throw .keychain(errSecDecode)
+        }
+    }
+
+    /// The shape `LauncherRankingStore` persists through, so its harnesses never see this type.
+    var loadAndSave: (load: @Sendable () -> Data?, save: @Sendable (Data) -> Void) {
+        (load: { try? self.read() }, save: { try? self.write($0) })
+    }
+
+    private func report() {
+        let name = url.lastPathComponent
+        Task { @MainActor in
+            NotificationCenter.default.post(name: Self.didFailNotification, object: name)
+        }
+    }
+}
