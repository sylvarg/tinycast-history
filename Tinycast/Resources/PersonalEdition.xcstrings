    "Every recalled search goes, and its key with it. This can't be undone." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle gespeicherten Eingaben und ihr Schlüssel werden gelöscht. Dies kann nicht widerrufen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se borran todas las búsquedas guardadas y su clave. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les saisies mémorisées sont supprimées, avec leur clé. Cette action est irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存された入力とその鍵がすべて削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 모든 입력과 해당 키가 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as pesquisas guardadas e a sua chave são apagadas. Não é possível desfazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все сохранённые запросы и их ключ будут удалены. Это действие нельзя отменить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有保存的输入及其密钥都将被删除。此操作无法撤销。"
          }
        }
      }
    },
